rules_version = '2';
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Path: media/{artistId}/{fileId}
//   - artistId: artist slug, ^[a-z0-9-]{1,80}$
//   - fileId: "<ms>-<random>.<ext>", generated by src/lib/media.js
//   - contentType image/* (<= 25 MB), video/* (<= 500 MB) or audio/* (<= 50 MB)
// The Firestore record stores the file's download URL. Public press kits load files
// through that URL's download token, which does not go through these rules.
//
// Who can write:
//   - staff: custom claim staff == true
//   - an artist: an anonymous session with custom claim artistId == {artistId}
// Both claims are set by the grantUploadAccess Cloud Function (functions/index.js),
// because Storage rules can only read the (default) Firestore database and this
// app uses the named "hngigs" database.
//
// Access: staff and the owning artist may get, create and delete. Only staff may list.
// Nobody may overwrite an existing file.
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    function ownsArtist(artistId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.auth.token.artistId == artistId;
    }

    function canEdit(artistId) {
      return artistId.matches('^[a-z0-9-]{1,80}$') && (isStaff() || ownsArtist(artistId));
    }

    function isAllowedUpload() {
      return request.resource.contentType is string
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 25 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size <= 500 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 50 * 1024 * 1024)
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /media/{artistId}/{fileId} {
      allow get: if canEdit(artistId);
      allow list: if isStaff();
      allow create: if canEdit(artistId)
        && fileId.matches('^[0-9]{10,16}-[a-z0-9]{1,12}\\.[a-z0-9]{1,8}$')
        && isAllowedUpload();
      allow update: if false;
      allow delete: if canEdit(artistId);
    }

    match /media/{artistId}/{allPaths=**} {
      allow list: if isStaff();
    }
  }
}
