{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "anonymous": true
    },
    "authorizedDomains": [
      "localhost",
      "hngigs-8a8b8.firebaseapp.com",
      "hngigs-8a8b8.web.app",
      "hngigs-dev.firebaseapp.com",
      "hngigs-dev.web.app"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "edition": "enterprise",
    "database": "hngigs",
    "location": "europe-west2"
  }
}
